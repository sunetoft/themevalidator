# ThemeValidator / ThemeInvestor — Environment Variables
# Copy this file to .env and fill in the values.

# PostgreSQL
DATABASE_URL=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://themeinvestor.bunnystocks.com

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LLM (Z.AI GLM)
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
LLM_MODEL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Cron
PAPER_TRADE_CRON_KEY=

# Twitter/X
X_API_BEARER_TOKEN=

# Admin
ADMIN_EMAIL=

# Email (Brevo)
BREVO_API_KEY=

# Cross-site API
CROSS_SITE_API_KEY=
TRADESCOUTER_INTERNAL_URL=http://localhost:3013
OPTIONLOOKUP_INTERNAL_URL=http://localhost:3011

# SSO
SSO_PROVIDER_URL=https://dashboard.bunnystocks.com
SSO_CLIENT_ID=themeinvestor
SSO_CLIENT_SECRET=

# FalkorDB graph database (this app only READS it indirectly — see AGENTS.md)
# Seeds are written to VALUE_CHAIN_ROOT/seed_incoming/ and merged by its loader.
FALKORDB_HOST=
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
# Target theme graph for exported seeds. Themes that share a supply base share a
# graph so company nodes are shared and multi-theme queries work. Never one graph
# per thesis.
FALKORDB_GRAPH=grid

# value-chain-trade repo — holds the seed schema, loader and the theme graphs
VALUE_CHAIN_ROOT=/Users/sune/projects/value-chain-trade

# Python interpreter for yfinance financial data fetches
# Falls back to the shared Hermes venv if unset.
PYTHON_BIN=/Users/Shared/Hermes/venv/bin/python3